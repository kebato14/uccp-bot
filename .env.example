# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Telegram ID администраторов бота через запятую (первичная загрузка).
# Эти пользователи получают роль "УЦЦП - Администратор бота" автоматически при /start.
BOOTSTRAP_ADMIN_IDS=

# Строка подключения к БД (по умолчанию SQLite в файле uccp.db)
DB_URL=sqlite+aiosqlite:///uccp.db

# Часовой пояс (Душанбе)
TIMEZONE=Asia/Dushanbe

# Валюта для отчётов
CURRENCY=сомони

# Проверка просроченных заявок, минут
OVERDUE_CHECK_MINUTES=15

# Уровень логов: INFO для отладки, WARNING на сервере (меньше нагрузка)
LOG_LEVEL=INFO

# Сеть до Telegram
POLLING_TIMEOUT=20
API_TIMEOUT=30
# Прокси, если канал до Telegram плохой: http://user:pass@host:port
TELEGRAM_PROXY=

# --- Google Sheets: автоматический ежемесячный отчёт ---
# Путь к JSON-ключу сервисного аккаунта Google (см. README, раздел «Google Sheets»)
GOOGLE_CREDENTIALS_FILE=google_credentials.json
# ID существующей таблицы (из ссылки .../spreadsheets/d/<ID>/edit).
# Если пусто — бот создаст таблицу сам и пришлёт ссылку администраторам.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TITLE=Отчёты УЦЦП
# Почта, которой открыть доступ к созданной таблице (ваш Google-аккаунт)
GOOGLE_SHARE_EMAIL=
# Когда формировать отчёт за прошедший месяц: день месяца и час
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_HOUR=1
# ID папки на Google Диске, куда класть таблицу (часть ссылки после /folders/)
GOOGLE_DRIVE_FOLDER_ID=

# --- Резервное копирование базы ---
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_HOUR=3
# 1 — присылать копию администраторам в Telegram, 0 — не присылать
BACKUP_TO_TELEGRAM=1
